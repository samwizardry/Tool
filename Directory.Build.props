<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <ToolTargetOS Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">Windows</ToolTargetOS>
    <ToolTargetOS Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">Linux</ToolTargetOS>
    <ToolTargetOS Condition="'$(ToolTargetOS)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</ToolTargetOS>
    <ToolTargetOS Condition="'$(ToolTargetOS)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</ToolTargetOS>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ToolTargetOS)' == 'Windows'">
    <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS;SUPPORT_DIRECTX;SUPPORT_VULKAN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ToolTargetOS)' == 'Linux'">
    <DefineConstants>$(DefineConstants);PLATFORM_LINUX;SUPPORT_VULKAN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <_ToolDebugConfig Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == ''">true</_ToolDebugConfig>

    <TrackAllocations Condition="'$(TrackAllocations)' == '' and '$(_ToolDebugConfig)' == 'true'">true</TrackAllocations>
    <TrackAllocations Condition="'$(TrackAllocations)' == ''">false</TrackAllocations>

    <ToolDebug Condition="'$(ToolDebug)' == '' and '$(_ToolDebugConfig)' == 'true'">true</ToolDebug>
    <ToolDebug Condition="'$(ToolDebug)' == ''">false</ToolDebug>

    <GraphicsDebug Condition="'$(GraphicsDebug)' == '' and '$(_ToolDebugConfig)' == 'true'">true</GraphicsDebug>
    <GraphicsDebug Condition="'$(GraphicsDebug)' == ''">false</GraphicsDebug>

    <!-- Compile-time minimum log severity: Message, Info, Warning, Error, Fatal, None -->
    <ToolLogSeverity Condition="'$(ToolLogSeverity)' == '' and '$(_ToolDebugConfig)' == 'true'">Message</ToolLogSeverity>
    <ToolLogSeverity Condition="'$(ToolLogSeverity)' == ''">None</ToolLogSeverity>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TrackAllocations)' == 'true'">
    <DefineConstants>$(DefineConstants);TRACK_ALLOCATIONS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ToolDebug)' == 'true'">
    <DefineConstants>$(DefineConstants);TOOL_DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GraphicsDebug)' == 'true'">
    <DefineConstants>$(DefineConstants);GRAPHICS_DEBUG</DefineConstants>
  </PropertyGroup>

  <!-- Cascade: enabling a log severity automatically enables all higher severities -->
  <PropertyGroup>
    <_LogMessage Condition="'$(ToolLogSeverity)' == 'Message'">true</_LogMessage>
    <_LogInfo    Condition="'$(ToolLogSeverity)' == 'Info'    or '$(_LogMessage)' == 'true'">true</_LogInfo>
    <_LogWarning Condition="'$(ToolLogSeverity)' == 'Warning' or '$(_LogInfo)' == 'true'">true</_LogWarning>
    <_LogError   Condition="'$(ToolLogSeverity)' == 'Error'   or '$(_LogWarning)' == 'true'">true</_LogError>
    <_LogFatal   Condition="'$(ToolLogSeverity)' == 'Fatal'   or '$(_LogError)' == 'true'">true</_LogFatal>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants Condition="'$(_LogFatal)' == 'true'">$(DefineConstants);TOOL_LOG</DefineConstants>
    <DefineConstants Condition="'$(_LogMessage)' == 'true'">$(DefineConstants);TOOL_LOG_MESSAGE</DefineConstants>
    <DefineConstants Condition="'$(_LogInfo)' == 'true'">$(DefineConstants);TOOL_LOG_INFO</DefineConstants>
    <DefineConstants Condition="'$(_LogWarning)' == 'true'">$(DefineConstants);TOOL_LOG_WARNING</DefineConstants>
    <DefineConstants Condition="'$(_LogError)' == 'true'">$(DefineConstants);TOOL_LOG_ERROR</DefineConstants>
    <DefineConstants Condition="'$(_LogFatal)' == 'true'">$(DefineConstants);TOOL_LOG_FATAL</DefineConstants>
  </PropertyGroup>
</Project>
